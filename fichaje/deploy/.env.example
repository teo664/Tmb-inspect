# Dominio con el que se abrirá la app (su registro DNS A debe apuntar a la IP del VPS).
# Sin dominio propio se puede usar <IP-del-VPS>.sslip.io, por ejemplo 203.0.113.10.sslip.io
DOMAIN=fichaje.technicalmb.net

# Primer administrador (solo se usa en el primer arranque)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contraseña
